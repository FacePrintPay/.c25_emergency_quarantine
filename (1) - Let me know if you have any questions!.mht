@import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap");

:root { --bg-dark: #050816; --bg-elevated: rgba(15, 23, 42, 0.9); --bg-card: rgba(15, 23, 42, 0.96); --border-subtle: rgba(148, 163, 184, 0.35); --accent: #0ea5e9; --accent-strong: #ec4899; --text-main: #e5e7eb; --text-muted: #9ca3af; --text-soft: #6b7280; --radius-pill: 999px; --shadow-soft: 0 24px 80px rgba(0, 0, 0, 0.65); --shadow-card: 0 18px 50px rgba(15, 23, 42, 0.9); --max-width: 1200px; }

.vc-shell { font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif; color: var(--text-main); -webkit-font-smoothing: antialiased; background: radial-gradient(circle at 0% 0%, rgba(56, 189, 248, 0.35), transparent 60%), radial-gradient(circle at 100% 100%, rgba(236, 72, 153, 0.35), transparent 60%), rgb(2, 6, 23); border-radius: 28px; margin-top: 24px; box-shadow: var(--shadow-soft); overflow: hidden; }

.vc-shell a { color: inherit; text-decoration: none; }

.vc-shell img { max-width: 100%; height: auto; display: block; }

.vc-container { width: 100%; max-width: var(--max-width); margin: 0px auto; padding: 20px 16px 32px; }

.vc-top-banner { text-align: center; padding: 10px 16px; font-size: 13px; color: var(--text-muted); background: rgba(15, 23, 42, 0.96); border-bottom: 1px solid rgba(148, 163, 184, 0.25); }

.vc-top-banner span { background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; background-clip: text; color: transparent; font-weight: 600; }

.vc-nav { position: sticky; top: 0px; z-index: 5; backdrop-filter: blur(18px); background: linear-gradient(rgba(2, 6, 23, 0.96), rgba(2, 6, 23, 0.78), transparent); border-bottom: 1px solid rgba(148, 163, 184, 0.25); }

.vc-nav-inner { max-width: var(--max-width); margin: 0px auto; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }

.vc-logo-wrap { display: flex; align-items: center; gap: 10px; }

.vc-logo-mark { width: 34px; height: 34px; border-radius: 12px; background: conic-gradient(from 140deg, rgb(14, 165, 233), rgb(34, 211, 238), rgb(168, 85, 247), rgb(236, 72, 153), rgb(14, 165, 233)); display: flex; align-items: center; justify-content: center; box-shadow: rgba(15, 23, 42, 0.95) 0px 0px 0px 1px, rgba(0, 0, 0, 0.7) 0px 18px 40px; font-size: 16px; font-weight: 800; color: rgb(11, 17, 32); }

.vc-logo-text-main { font-size: 18px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

.vc-logo-text-sub { font-size: 11px; opacity: 0.7; text-transform: uppercase; letter-spacing: 0.16em; }

.vc-nav-links { display: flex; gap: 18px; align-items: center; font-size: 13px; color: var(--text-muted); flex-wrap: wrap; justify-content: flex-end; }

.vc-nav-links a { position: relative; padding-bottom: 2px; }

.vc-nav-links a::after { content: ""; position: absolute; left: 0px; bottom: -3px; width: 0px; height: 2px; border-radius: 999px; background: linear-gradient(90deg, var(--accent), var(--accent-strong)); transition: width 0.18s ease-out; }

.vc-nav-links a:hover::after { width: 100%; }

.vc-nav-cta { display: flex; gap: 8px; flex-wrap: wrap; }

.vc-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; border-radius: var(--radius-pill); padding: 7px 14px; font-size: 13px; border: 1px solid transparent; cursor: pointer; background: transparent; color: var(--text-main); transition: background 0.18s ease-out, border-color 0.18s ease-out, transform 0.12s ease-out, box-shadow 0.18s ease-out; text-decoration: none; white-space: nowrap; }

.vc-btn-primary { background: linear-gradient(135deg, var(--accent), var(--accent-strong)); color: rgb(11, 17, 32); font-weight: 600; box-shadow: rgba(15, 23, 42, 0.9) 0px 14px 35px; }

.vc-btn-primary:hover { transform: translateY(-1px); box-shadow: rgba(0, 0, 0, 0.95) 0px 18px 40px; }

.vc-btn-ghost { border-color: rgba(148, 163, 184, 0.5); background: rgba(15, 23, 42, 0.8); }

.vc-btn-ghost:hover { background: rgb(15, 23, 42); border-color: var(--accent); }

.vc-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: var(--radius-pill); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; background: radial-gradient(circle at 0px 0px, rgba(56, 189, 248, 0.3), transparent 60%), rgba(15, 23, 42, 0.92); border: 1px solid rgba(148, 163, 184, 0.4); color: var(--text-muted); }

.vc-chip-dot { width: 7px; height: 7px; border-radius: 999px; background: radial-gradient(circle, rgb(34, 197, 94), rgb(22, 163, 74)); box-shadow: rgba(22, 163, 74, 0.18) 0px 0px 0px 4px; }

.vc-main-grid { margin-top: 24px; display: grid; grid-template-columns: minmax(0px, 3fr) minmax(0px, 2.4fr); gap: 26px; align-items: flex-start; }

.vc-hero-left { background: linear-gradient(145deg, rgba(15, 23, 42, 0.98), rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.98)); border-radius: 26px; padding: 22px 22px 20px; border: 1px solid rgba(148, 163, 184, 0.38); box-shadow: var(--shadow-soft); position: relative; overflow: hidden; }

.vc-hero-left::before { content: ""; position: absolute; inset: -1px; border-radius: inherit; border: 1px solid transparent; background: linear-gradient(135deg, rgba(56, 189, 248, 0.5), transparent 40%, rgba(236, 72, 153, 0.6)) border-box border-box; mask: linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 0px) padding-box exclude, linear-gradient(rgb(0, 0, 0) 0px, rgb(0, 0, 0) 0px); opacity: 0.35; pointer-events: none; }

.vc-eyebrow-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }

.vc-eyebrow-tag { font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); background: rgba(15, 23, 42, 0.9); padding: 4px 10px; border-radius: var(--radius-pill); border: 1px solid rgba(56, 189, 248, 0.4); }

.vc-hero-title { font-size: clamp(26px, 4vw, 34px); line-height: 1.15; margin-bottom: 10px; letter-spacing: 0.02em; }

.vc-hero-title span.vc-gradient { background: linear-gradient(120deg, rgb(14, 165, 233), rgb(34, 211, 238), rgb(168, 85, 247), rgb(236, 72, 153), rgb(249, 115, 22)) text; color: transparent; }

.vc-hero-sub { font-size: 14px; color: var(--text-muted); max-width: 540px; margin-bottom: 18px; }

.vc-hero-sub b { color: rgb(229, 231, 235); font-weight: 600; }

.vc-quick-steps { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 8px; margin: 14px 0px 18px; font-size: 12px; }

.vc-step-pill { border-radius: 14px; padding: 8px 10px; border: 1px solid rgba(148, 163, 184, 0.4); background: radial-gradient(circle at 0px 0px, rgba(56, 189, 248, 0.12), transparent 60%), rgba(15, 23, 42, 0.95); display: flex; flex-direction: column; gap: 3px; }

.vc-step-pill-label { font-size: 11px; color: var(--text-soft); text-transform: uppercase; letter-spacing: 0.12em; }

.vc-step-pill-main { font-size: 12px; color: var(--text-main); font-weight: 500; }

.vc-cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; }

.vc-cta-caption { font-size: 11px; color: var(--text-soft); }

.vc-cta-caption b { color: rgb(229, 231, 235); font-weight: 600; }

.vc-enroll-card { margin-top: 16px; border-radius: 18px; border: 1px solid rgba(148, 163, 184, 0.5); background: radial-gradient(circle at 0px 0px, rgba(236, 72, 153, 0.26), transparent 65%), rgba(15, 23, 42, 0.96); padding: 14px 14px 12px; }

.vc-enroll-title-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 8px; }

.vc-enroll-title { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(254, 202, 202); }

.vc-enroll-pill { font-size: 11px; color: rgb(249, 168, 212); padding: 3px 9px; border-radius: var(--radius-pill); background: rgba(15, 23, 42, 0.92); border: 1px solid rgba(248, 113, 113, 0.55); }

.vc-enroll-form { display: grid; grid-template-columns: minmax(0px, 1.7fr) minmax(0px, 1.3fr); gap: 8px; align-items: center; margin-bottom: 8px; }

.vc-input-wrap { display: flex; flex-direction: column; gap: 5px; font-size: 11px; color: var(--text-soft); }

.vc-input-wrap label { text-transform: uppercase; letter-spacing: 0.14em; }

.vc-input { padding: 8px 10px; border-radius: 999px; border: 1px solid rgba(248, 250, 252, 0.12); background: rgba(15, 23, 42, 0.9); color: var(--text-main); font-size: 13px; outline: none; width: 100%; }

.vc-input::placeholder { color: rgba(148, 163, 184, 0.8); }

.vc-enroll-bullets { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 8px; margin-top: 6px; font-size: 11px; color: var(--text-soft); }

.vc-enroll-bullet b { display: block; color: var(--text-main); font-size: 11px; margin-bottom: 2px; }

.vc-enroll-subnote { margin-top: 8px; font-size: 11px; color: rgba(248, 250, 252, 0.8); }

.vc-enroll-subnote span { color: rgb(249, 168, 212); font-weight: 600; }

.vc-hero-right { display: flex; flex-direction: column; gap: 16px; }

.vc-card { border-radius: 20px; background: var(--bg-card); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-card); padding: 16px 16px 14px; }

.vc-card-header { display: flex; justify-content: space-between; gap: 10px; align-items: center; margin-bottom: 10px; }

.vc-card-title { font-size: 13px; text-transform: uppercase; letter-spacing: 0.16em; color: rgb(203, 213, 245); }

.vc-card-subtitle { font-size: 11px; color: var(--text-soft); }

.vc-tag-pill { font-size: 11px; padding: 4px 8px; border-radius: var(--radius-pill); border: 1px solid rgba(148, 163, 184, 0.55); background: radial-gradient(circle at 100% 0px, rgba(56, 189, 248, 0.2), transparent 60%), rgba(15, 23, 42, 0.96); color: var(--text-muted); }

.vc-actions-grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 10px; margin-top: 4px; }

.vc-action-tile { border-radius: 14px; border: 1px solid rgba(148, 163, 184, 0.4); background: radial-gradient(circle at 0px 0px, rgba(59, 130, 246, 0.2), transparent 60%), rgba(15, 23, 42, 0.96); padding: 10px 10px 8px; font-size: 12px; }

.vc-action-label { font-weight: 500; margin-bottom: 2px; }

.vc-action-caption { font-size: 11px; color: var(--text-soft); }

.vc-fee-note { margin-top: 10px; font-size: 11px; color: var(--text-soft); }

.vc-fee-note b { color: var(--text-main); }

.vc-status-list { display: grid; gap: 6px; font-size: 11px; margin-top: 6px; color: var(--text-soft); }

.vc-status-item { display: flex; align-items: center; gap: 6px; }

.vc-status-dot { width: 8px; height: 8px; border-radius: 999px; background: radial-gradient(circle, rgb(34, 197, 94), rgb(22, 163, 74)); box-shadow: rgba(22, 163, 74, 0.18) 0px 0px 0px 3px; }

.vc-status-dot.pending { background: radial-gradient(circle, rgb(250, 204, 21), rgb(234, 179, 8)); box-shadow: rgba(234, 179, 8, 0.22) 0px 0px 0px 3px; }

.vc-status-dot.offline { background: radial-gradient(circle, rgb(249, 115, 22), rgb(234, 88, 12)); box-shadow: rgba(248, 113, 22, 0.25) 0px 0px 0px 3px; }

.vc-section { margin-top: 32px; border-radius: 24px; border: 1px solid rgba(148, 163, 184, 0.35); background: radial-gradient(circle at 0px 0px, rgba(56, 189, 248, 0.18), transparent 55%), radial-gradient(circle at 100% 100%, rgba(236, 72, 153, 0.22), transparent 55%), rgba(15, 23, 42, 0.96); padding: 20px 18px 18px; box-shadow: var(--shadow-soft); }

.vc-section-header { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }

.vc-section-title { font-size: 18px; letter-spacing: 0.05em; text-transform: uppercase; }

.vc-section-kicker { font-size: 12px; color: var(--text-muted); max-width: 420px; }

.vc-pill-band { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: var(--radius-pill); border: 1px solid rgba(148, 163, 184, 0.5); font-size: 11px; color: var(--text-muted); background: rgba(15, 23, 42, 0.9); }

.vc-cta-row-wide { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }

.vc-split-grid { display: grid; grid-template-columns: minmax(0px, 1.1fr) minmax(0px, 1.2fr); gap: 18px; }

.vc-list { list-style: none; display: grid; gap: 6px; font-size: 13px; color: var(--text-muted); }

.vc-list li::before { content: "â€¢"; margin-right: 6px; color: var(--accent); }

.vc-card-subgrid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 10px; margin-top: 6px; }

.vc-mini-card { border-radius: 16px; padding: 10px 10px 8px; border: 1px solid rgba(148, 163, 184, 0.4); background: radial-gradient(circle at 0px 0px, rgba(56, 189, 248, 0.18), transparent 60%), rgba(15, 23, 42, 0.96); font-size: 12px; }

