#pay-buttons-js-container, #pay-buttons-js-container * { box-sizing: border-box; }

#pay-buttons-js-container { width: 441px; max-width: 100%; height: 100vh; background: rgb(244, 248, 252); position: fixed; top: 0px; display: none; right: -300px; z-index: 9999910; overflow: scroll; }

#pay-buttons-js-header { width: 100%; background: rgb(30, 40, 40); color: rgb(221, 221, 221); display: flex; align-items: center; justify-content: space-between; padding: 12px; line-height: 125%; }

#pay-buttons-js-header, #pay-buttons-js-checkout-complete-cta { font-family: Helvetica, Arial; }

#pay-buttons-js-header-close-cta { display: flex; cursor: pointer; }

#pay-buttons-js-header-close-cta svg { width: 18px; height: 18px; }

#pay-buttons-js-header-close-cta > img { width: 22px; height: 100%; vertical-align: middle; }

#pay-buttons-js-checkout-complete-cta { display: none; color: rgb(17, 17, 17); margin-bottom: 20px; }

#pay-buttons-js-content { align-items: center; text-align: center; max-width: 100%; overflow-x: hidden; }

#pay-buttons-js-iframe { width: 100%; height: 200px; background: rgb(255, 255, 255); margin: 0px; padding: 0px; border: 0px; }

#pay-buttons-js-backdrop.pay-buttons-js-show, #pay-buttons-js-container.pay-buttons-js-show { display: block; right: 0px; animation: 500ms ease 0s 1 normal none running slide; }

#pay-buttons-js-backdrop { display: none; z-index: 99999; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.7); }

@keyframes slide { 
  0% { right: -300px; }
  100% { right: 0px; }
}
