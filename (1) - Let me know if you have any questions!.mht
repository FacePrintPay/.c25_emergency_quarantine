@keyframes rareNeckAnim { 
  0% { transform: translate(0px) rotate(10deg); }
  10% { transform: translate(calc(-5px*var(--writing-dir-flip)),-1px) rotate(1deg); }
  20% { transform: translate(calc(-9px*var(--writing-dir-flip))) rotate(-12deg); }
  30% { transform: translate(calc(-10px*var(--writing-dir-flip)),2px) rotate(-15deg); }
  40% { transform: translate(calc(-11px*var(--writing-dir-flip)),2px) rotate(-17deg); }
  50% { transform: translate(calc(-9px*var(--writing-dir-flip)),3px) rotate(-18deg); }
  60% { transform: translate(calc(-6px*var(--writing-dir-flip)),5px) rotate(5deg); }
  70% { transform: translate(calc(-2px*var(--writing-dir-flip)),5px) rotate(9deg); }
  80% { transform: translate(calc(1px*var(--writing-dir-flip)),4px) rotate(15deg); }
  90% { transform: translate(calc(2px*var(--writing-dir-flip)),3px) rotate(14deg); }
  100% { transform: translate(0px) rotate(10deg); }
}

@keyframes rareEmoteAnim { 
  0% { transform: translate(0px); }
  10% { transform: translate(calc(-5px*var(--writing-dir-flip)),-1px); }
  20% { transform: translate(calc(-9px*var(--writing-dir-flip))); }
  30% { transform: translate(calc(-12px*var(--writing-dir-flip)),2px); }
  40% { transform: translate(calc(-13px*var(--writing-dir-flip)),2px); }
  50% { transform: translate(calc(-10px*var(--writing-dir-flip)),3px); }
  60% { transform: translate(calc(-6px*var(--writing-dir-flip)),5px); }
  70% { transform: translate(calc(-2px*var(--writing-dir-flip)),5px); }
  80% { transform: translate(calc(1px*var(--writing-dir-flip)),4px); }
  90% { transform: translate(calc(2px*var(--writing-dir-flip)),3px); }
  100% { transform: translate(0px); }
}

.rare-emote__face { height: 2.8rem; }

.rare-emote__face--animate { animation: 0.4s ease 0s infinite normal none running rareEmoteAnim; }

