.vc-demo-sub { font-size: 14px; color: var(--text-muted); max-width: 520px; margin-bottom: 14px; }

.vc-demo-sub b { color: rgb(229, 231, 235); }

.vc-demo-steps { margin-top: 10px; display: grid; gap: 10px; }

.vc-demo-step { display: grid; grid-template-columns: auto minmax(0px, 1fr); gap: 10px; align-items: flex-start; padding: 9px 10px; border-radius: 16px; border: 1px solid rgba(148, 163, 184, 0.45); background: rgba(15, 23, 42, 0.96); }

.vc-demo-step-num { width: 26px; height: 26px; border-radius: 999px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; background: radial-gradient(circle at 0px 0px, rgba(56, 189, 248, 0.9), rgba(236, 72, 153, 0.9)); color: rgb(2, 6, 23); box-shadow: rgba(0, 0, 0, 0.7) 0px 10px 22px; }

.vc-demo-step-main { font-size: 13px; color: var(--text-main); margin-bottom: 2px; font-weight: 500; }

.vc-demo-step-sub { font-size: 12px; color: var(--text-soft); }

.vc-demo-footer-note { margin-top: 14px; font-size: 11px; color: var(--text-soft); }

.vc-demo-footer-note span { color: var(--accent); font-weight: 500; }

.vc-demo-phone-wrap { display: flex; align-items: center; justify-content: center; }

.vc-demo-phone { width: 100%; max-width: 340px; aspect-ratio: 9 / 19; border-radius: 32px; padding: 10px; background: radial-gradient(circle at 0px 0px, rgba(56, 189, 248, 0.4), transparent 60%), radial-gradient(circle at 100% 100%, rgba(236, 72, 153, 0.4), transparent 60%), rgb(2, 6, 23); border: 1px solid rgba(148, 163, 184, 0.5); box-shadow: rgba(0, 0, 0, 0.9) 0px 30px 70px; position: relative; overflow: hidden; }

.vc-demo-phone-notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 110px; height: 16px; border-radius: 999px; background: rgb(2, 6, 23); }

.vc-demo-phone-inner { position: relative; margin-top: 20px; width: 100%; height: calc(100% - 26px); border-radius: 24px; background: linear-gradient(145deg, rgba(15, 23, 42, 0.98), rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.98)); border: 1px solid rgba(30, 64, 175, 0.9); padding: 10px 9px; display: flex; flex-direction: column; justify-content: space-between; }

.vc-demo-status-bar { display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: var(--text-muted); margin-bottom: 6px; }

.vc-demo-status-case { font-weight: 500; font-size: 11px; color: rgb(229, 231, 235); }

.vc-demo-chip { padding: 2px 7px; border-radius: 999px; border: 1px solid rgba(56, 189, 248, 0.7); font-size: 10px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); background: rgba(15, 23, 42, 0.95); }

.vc-demo-video-grid { flex: 1 1 0%; display: grid; grid-template-rows: 1.2fr 0.9fr 0.75fr; gap: 6px; }

.vc-demo-tile { border-radius: 16px; padding: 8px; border: 1px solid rgba(30, 64, 175, 0.8); background: radial-gradient(circle at 0px 0px, rgba(56, 189, 248, 0.22), transparent 60%), rgba(15, 23, 42, 0.96); display: flex; align-items: flex-end; justify-content: space-between; position: relative; overflow: hidden; }

.vc-demo-avatar-ring { width: 46px; height: 46px; border-radius: 999px; border: 2px solid rgba(96, 165, 250, 0.8); display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 30% 20%, rgb(56, 189, 248), rgb(29, 78, 216)); box-shadow: rgba(15, 23, 42, 0.9) 0px 10px 26px; font-size: 22px; font-weight: 700; color: rgb(229, 231, 235); }

.vc-demo-avatar-ring.judge { border-color: rgba(251, 191, 36, 0.9); background: radial-gradient(circle at 30% 20%, rgb(250, 204, 21), rgb(234, 88, 12)); }

.vc-demo-tile-label { position: absolute; left: 8px; top: 6px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; padding: 2px 6px; border-radius: 999px; background: rgba(15, 23, 42, 0.92); color: var(--text-muted); }

.vc-demo-tile-meta { font-size: 10px; color: var(--text-soft); text-align: right; }

.vc-demo-tile-meta span { display: block; }

.vc-demo-receipt { border-radius: 14px; padding: 6px 8px; border: 1px dashed rgba(34, 197, 94, 0.85); background: radial-gradient(circle at 0px 0px, rgba(34, 197, 94, 0.18), transparent 60%), rgba(15, 23, 42, 0.96); font-size: 10px; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center; }

.vc-demo-receipt strong { color: rgb(187, 247, 208); font-size: 10px; }

.vc-demo-receipt-code { font-family: "SF Mono", ui-monospace, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; font-size: 9px; color: rgb(74, 222, 128); }

.vc-demo-controls { margin-top: 6px; padding: 7px 10px 4px; border-radius: 999px; border: 1px solid rgba(30, 64, 175, 0.9); background: radial-gradient(circle at 50% 0px, rgba(56, 189, 248, 0.28), transparent 55%), rgba(15, 23, 42, 0.98); display: flex; align-items: center; justify-content: space-between; gap: 10px; }

.vc-demo-controls-left { display: flex; gap: 6px; align-items: center; }

.vc-demo-pill { padding: 3px 8px; border-radius: 999px; font-size: 10px; border: 1px solid rgba(148, 163, 184, 0.6); color: var(--text-muted); background: rgba(15, 23, 42, 0.9); }

.vc-demo-btn-circle { width: 26px; height: 26px; border-radius: 999px; display: flex; align-items: center; justify-content: center; font-size: 12px; border: 1px solid rgba(148, 163, 184, 0.7); background: rgba(15, 23, 42, 0.96); color: var(--text-main); }

.vc-demo-btn-circle.leave { border: none; background: radial-gradient(circle at 30% 20%, rgb(249, 115, 22), rgb(185, 28, 28)); color: rgb(254, 226, 226); box-shadow: rgba(127, 29, 29, 0.85) 0px 10px 24px; }

.vc-demo-latency { font-size: 9px; color: var(--text-soft); }

.vc-demo-latency span { color: rgb(34, 197, 94); }
