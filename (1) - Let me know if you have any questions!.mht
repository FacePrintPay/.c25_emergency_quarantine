.gift-theme-selector__background { background-color: var(--color-border-selectable); border-radius: 2px; }

.discounted-bundle-box { border: 2px solid var(--color-background-accent); border-radius: 6px; margin-bottom: 1rem; overflow: hidden; }

.discounted-bundle-box__header { background-color: var(--color-background-accent); padding-inline-end: 10px; }

.discounted-bundle-box > :not(:last-child) { margin-bottom: 1rem; }

.discounted-gift-option-container-blue-to-purple { border: 2px solid rgb(130, 5, 180); border-radius: 6px; margin-bottom: 1rem; overflow: hidden; }

.discounted-gift-option-container-blue-to-purple__header { background: linear-gradient(90deg, rgb(30, 105, 255), rgb(130, 5, 180)); padding-inline-end: 10px; }

.discounted-gift-option-container-blue-to-purple > :not(:last-child) { margin-bottom: 1rem; }

.promotional-gift-options-box-pink-to-purple { background: linear-gradient(var(--color-background-body),var(--color-background-body)) padding-box,linear-gradient(to right,#be0078,#8205b4) border-box; border: 2px solid transparent; border-radius: 6px; margin-bottom: 1rem; overflow: hidden; }

.promotional-gift-options-box-pink-to-purple__header { background: linear-gradient(90deg, rgb(190, 0, 120), rgb(130, 5, 180)); padding-inline-end: 10px; }

.promotional-gift-options-box-pink-to-purple > :not(:last-child) { margin-bottom: 1rem; }

.treasure-discount-box { background: linear-gradient(var(--color-background-body),var(--color-background-body)) padding-box,linear-gradient(to right,#1345aa,#9147ff) border-box; border: 2px solid transparent; border-radius: 6px; margin-bottom: 1rem; overflow: hidden; }

.treasure-discount-box__header { background: linear-gradient(90deg, rgb(19, 69, 170), rgb(145, 71, 255)); padding-inline-end: 10px; }

.treasure-discount-box > :not(:last-child) { margin-bottom: 1rem; }

.one-click-confirmation-modal__gift-image { height: 6rem; }

.offer_thumbnail { border-radius: 50%; margin-top: 0.2rem; max-height: 2rem; max-width: 2rem; }

.spender-rewards-support-preview__tooltip, .spender-rewards-support-preview__tooltip:visited { color: var(--color-text-tooltip); }

.gifting-auto-scroll-highlight { animation: 2s ease-in-out 0s 1 normal none running progress; }

@keyframes progress { 
  0% { background-color: var(--color-background-accent); }
  100% { background-color: transparent; }
}

.sub-badge-progress__all-badges--text, .sub-badge-progress__current-badge--text, .sub-badge-progress__next-badge--text { color: rgb(173, 173, 184); }

.sub-badge-progress__current-badge { margin-inline: 1rem -1rem; }

.sub-badge-progress__next-badge { margin-inline: -1rem 1rem; }

.sub-badge-progress .chat-badge { height: 3.6rem; margin: 0px; width: 3.6rem; }

.tier-sub-badge { width: 11rem; }

.chat-badge { margin-inline-end: 0.3rem; margin-bottom: 0.15rem; vertical-align: middle; }

.chat-badge__lock { height: 1.5rem; inset-inline-start: 2.5rem; top: 2.2rem; width: 1.5rem; }

.gifter-badge-progress__bar { top: -4rem; }

.gifter-badge-progress__to-next { width: 70%; }

.gifter-badge-progress__set__bar { top: 3.5rem; width: 62%; }

